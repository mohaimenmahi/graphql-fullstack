# Copy to .env (git-ignored) and adjust. docker-compose.yml reads it.

# Your own Postgres container, reached by its container name on the shared Docker network.
# (If your Postgres only publishes 5432 on the host, use @host.docker.internal:5432 instead.)
DATABASE_URL=postgres://library:library@postgres:5432/library

DB_RUN_MIGRATIONS=true
SEED_DEMO_DATA=true

# Browser origins allowed to call this API (the two frontends).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001